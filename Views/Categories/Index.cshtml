@model IEnumerable<Book.Models.Category>

@{
    ViewData["Title"] = "Danh sách thể loại";
}

<h1>Quản lý thể loại</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Thêm thể loại</a>
</p>

<table class="table table-striped table-bordered align-middle" style="max-width: 600px;">
    <thead class="table-light">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Name)</td>
            <td class="text-nowrap">
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>
