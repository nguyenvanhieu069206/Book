@model Book.Models.BookItem

@{
    ViewData["Title"] = "Chi tiết sách";
}

<h1>Chi tiết sách</h1>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Title)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Title)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Author)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Author)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Publisher)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Publisher)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PublishYear)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.PublishYear)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Price)</dt>
            <dd class="col-sm-8">@Model.Price.ToString("N0") đ</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Quantity)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Quantity)</dd>

            <dt class="col-sm-4">Thể loại</dt>
            <dd class="col-sm-8">@Model.Category?.Name</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Description)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Description)</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Sửa</a>
    <a asp-action="Index" class="btn btn-secondary">Về danh sách</a>
</div>
