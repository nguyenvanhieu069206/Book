@model Book.Models.BookItem

@{
    ViewData["Title"] = "Xóa sách";
}

<h1>Xóa sách</h1>

<h3 class="text-danger">Bạn có chắc muốn xóa sách này không?</h3>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Title)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Title)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Author)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Author)</dd>

            <dt class="col-sm-4">Thể loại</dt>
            <dd class="col-sm-8">@Model.Category?.Name</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Price)</dt>
            <dd class="col-sm-8">@Model.Price.ToString("N0") đ</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
</form>
